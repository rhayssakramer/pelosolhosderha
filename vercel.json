{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx ng build --configuration production",
  "outputDirectory": "dist/pelosolhosderha/browser",
  "installCommand": "npm install --legacy-peer-deps",
  "rewrites": [
    { "source": "/((?!.*\\.(?:js|css|json|ico|png|jpg|jpeg|gif|svg|woff|woff2|ttf|eot|map)$).*)", "destination": "/index.html" }
  ]
}
