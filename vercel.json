{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx ng build --configuration production",
  "outputDirectory": "dist/pelosolhosderha/browser",
  "installCommand": "npm install --legacy-peer-deps",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "all" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/uploads/:path*", "destination": "https://pelosolhosderha-api.bluesea-ecfbf889.brazilsouth.azurecontainerapps.io/uploads/:path*" },
    { "source": "/((?!.*\\.(?:js|css|json|ico|png|jpg|jpeg|gif|svg|woff|woff2|ttf|eot|map)$)(?!uploads/).*)", "destination": "/index.html" }
  ]
}
