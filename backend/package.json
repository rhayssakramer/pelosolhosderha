{
  "name": "pelosolhosderha-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API for Pelos Olhos de Rha",
  "main": "dist/index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "build": "node esbuild.config.js",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate:dev": "cross-env NODE_ENV=development prisma migrate dev",
    "db:migrate:homolog": "cross-env NODE_ENV=homolog prisma migrate deploy",
    "db:migrate:prod": "cross-env NODE_ENV=production prisma migrate deploy",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.32.0",
    "@neondatabase/serverless": "^0.10.0",
    "@prisma/adapter-neon": "^6.0.0",
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.19",
    "@types/uuid": "^10.0.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.24.2",
    "prisma": "^6.0.0",
    "tsx": "^4.23.1",
    "typescript": "~5.8.2"
  }
}
